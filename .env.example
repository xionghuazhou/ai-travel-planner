# ============================================================
# TravelAI environment configuration (used by docker-compose)
# Copy this file to .env and fill in your own API key.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# Any OpenAI-compatible endpoint works: SiliconFlow, OpenAI,
# DeepSeek, or a local vLLM / Ollama server.
# ============================================================

# ===== LLM =====
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# On startup the backend probes these candidates and uses the first available one.
LLM_MODEL_CANDIDATES=deepseek-ai/DeepSeek-V4-Flash,deepseek-ai/DeepSeek-V3,deepseek-chat

# ===== Security (change to a random string) =====
SECRET_KEY=change-me-to-a-random-string

# ===== RAG =====
# local = zero-dependency hash embeddings (works offline)
# openai = real semantic embeddings via the /embeddings API
EMBEDDING_PROVIDER=local
VECTOR_STORE_PATH=./data/vectorstore

# ===== External services =====
# Leave empty to use simulated weather data (no key required).
WEATHER_API_KEY=
SEARCH_BACKEND=auto

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000